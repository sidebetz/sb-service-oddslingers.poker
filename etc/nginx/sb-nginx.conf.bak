# sibebetz oddslingers.poker

pid /tmp/nginx.pid;
error_log /dev/stderr;

events {
    worker_connections 1024;
}

http {
    include       mime.types;
    default_type  application/octet-stream;

    access_log /dev/stdout;
    sendfile        on;
    keepalive_timeout 65;

    # Avoid using default client_body_temp_path inside Docker
    client_body_temp_path /tmp/nginx_body_temp;

    server {
        listen 8080;  # Match Docker-exposed port if needed
        server_name localhost;

        # Static files
        location /static/ {
            alias /opt/oddslingers.poker/data/static/;
            autoindex off;
        }

        # Media files
        location /media/ {
            alias /opt/oddslingers.poker/data/media/;
            autoindex off;
        }

	    location / {
	        proxy_pass http://127.0.0.1:8000;

	        proxy_http_version 1.1;
	        proxy_set_header Upgrade $http_upgrade;
	        proxy_set_header Connection "upgrade";

	        proxy_set_header Host $host;
	        proxy_set_header X-Real-IP $remote_addr;
	        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
	        proxy_set_header X-Forwarded-Proto $scheme;
	    }
        location /ws/ {
            proxy_pass http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            # proxy_set_header Host $host;
        }
        location /table/ {
            proxy_pass http://127.0.0.1:8000;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
        }
     }
 }